{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jarvis",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOT_STATE",
        "class_name": "TradingBotState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TradingBotState"]
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
