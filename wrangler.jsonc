{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jarvis",
  "main": "src/live-wrapper.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "keep_vars": true,
  "vars": {
    "PAPER_TAKER_ADDRESS": "0x7aCd7C622a87a148CcdEBd213D7C4070E200186F"
  },
  "secrets": {
    "required": [
      "GEMINI_API_KEY",
      "GEMINI_API_KEY_FALLBACK_1",
      "GEMINI_API_KEY_FALLBACK_2",
      "ZEROEX_API_KEY",
      "UNISWAP_API_KEY",
      "THE_GRAPH_API_KEY"
    ]
  },
  "durable_objects": {
    "bindings": [
      { "name": "BOT_STATE", "class_name": "TradingBotState" },
      { "name": "RISK_STATE", "class_name": "RiskState" },
      { "name": "LIVE_STATE", "class_name": "LiveTradingState" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TradingBotState"] },
    { "tag": "v2", "new_sqlite_classes": ["RiskState"] },
    { "tag": "v3", "new_sqlite_classes": ["LiveTradingState"] }
  ],
  "triggers": { "crons": ["*/5 * * * *"] }
}
