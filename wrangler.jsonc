{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jarvis",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "keep_vars": true,
  "vars": {
    "PAPER_TAKER_ADDRESS": "0x7aCd7C622a87a148CcdEBd213D7C4070E200186F"
  },
  "durable_objects": {
    "bindings": [
      { "name": "BOT_STATE", "class_name": "TradingBotState" },
      { "name": "RISK_STATE", "class_name": "RiskState" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TradingBotState"] },
    { "tag": "v2", "new_sqlite_classes": ["RiskState"] }
  ],
  "triggers": { "crons": ["*/5 * * * *"] }
}
